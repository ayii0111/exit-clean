{
  "hooks": {
    "UserPromptExpansion": [
      {
        "matcher": "exit-clean",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}\"/hooks/exit-clean.sh",
            "timeout": 300
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}\"/hooks/exit-clean-confirm.sh"
          }
        ]
      }
    ]
  }
}
